<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup is off on purpose: the journal is meant to stay on this
         phone, and the welcome screen promises as much ("uninstalling it
         deletes your trades"). Leaving it on would quietly copy the journal to
         the user's Google account. Backups are the app's own export instead. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- No permissions. The app never uses the network: its pages are served
         from inside the APK, the journal and images live in its own storage,
         and links and the share sheet are handed to other apps. Tested
         without INTERNET on a device: loading, image saving, backup sharing
         and opening links all work. Debug builds add INTERNET back
         (src/debug/AndroidManifest.xml) only for the live-reload dev server. -->
</manifest>
