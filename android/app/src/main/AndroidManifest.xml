<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup is off on purpose: the journal is not copied to the
         user's Google account, and the welcome screen promises as much
         ("uninstalling it deletes your trades"). Backups are the app's own
         export instead. Since Android 12 this no longer stops the copy from
         an old phone to a new one when the user sets the new one up; that is
         kept on purpose (decided 2026-10-18), so a journal moves with its
         owner, and the privacy policy says so. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- No permissions. The app never uses the network: its pages are served
         from inside the APK, the journal and images live in its own storage,
         and links and the share sheet are handed to other apps. Tested
         without INTERNET on a device: loading, image saving, backup sharing
         and opening links all work. Debug builds add INTERNET back
         (src/debug/AndroidManifest.xml) only for the live-reload dev server. -->
</manifest>
