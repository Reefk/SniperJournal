<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon on Android 8 and up: the launcher masks these layers to
     whatever shape it uses, and may drop all but the monochrome one when the
     phone is set to themed icons. All three come from scripts/make-icons.mjs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
