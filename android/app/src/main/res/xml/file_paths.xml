<?xml version="1.0" encoding="utf-8"?>
<!-- What the app may hand to another app through the share sheet. Exports are
     written to the app's cache and shared from there, so that is all this
     exposes; the journal itself and the rest of the device stay out of reach. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="exports" path="." />
</paths>
