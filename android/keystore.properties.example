# Copy this file to android/keystore.properties and fill in your own values.
# That copy is gitignored, as is the .jks itself — neither belongs in the repo.
#
# Make the key once, from the android/ folder:
#
#   "%JAVA_HOME%\bin\keytool" -genkeypair -v ^
#     -keystore upload-keystore.jks -alias upload ^
#     -keyalg RSA -keysize 2048 -validity 10000
#
# keytool asks for the password and your name/organisation. Back the .jks and
# the passwords up somewhere safe and off this machine: Google Play ties the
# listing to this key, and there is no way to regenerate it. (Enrolling in Play
# App Signing, which Google does by default, gives you a reset path if it is
# ever lost — do not skip it.)
#
# storeFile is relative to the android/ folder.

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
